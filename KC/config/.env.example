# 提取 LLM（留空则进入 mock 提取，用于无 key 验证链路）
EXTRACT_LLM_API_KEY=
EXTRACT_LLM_BASE_URL=https://api.deepseek.com/v1
EXTRACT_LLM_MODEL=deepseek-chat
EXTRACT_LLM_MAX_TOKENS=4096
EXTRACT_LLM_TIMEOUT_MS=120000
EXTRACT_LLM_RETRIES=3

# Codex sessions 目录（rollout JSONL 所在目录，默认 ~/.codex/sessions）
KC_SESSIONS_DIR=

# 知识库输出目录（默认项目内 knowledge_library）
KC_KNOWLEDGE_DIR=

KC_COOLDOWN_MS=300000
KC_SCAN_INTERVAL_MS=60000
